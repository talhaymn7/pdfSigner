{
  "name": "pdf-imza",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "build": "vite build",
    "preview": "vite preview --open",
    "test": "vitest run",
    "test:e2e": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from e2e",
    "screenshots": "docker compose -f docker-compose.test.yml run --rm --build e2e node screenshots.js"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-serif": "^0.4.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
